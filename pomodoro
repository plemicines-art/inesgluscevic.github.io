<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Minuteur Pomodoro</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&display=swap" rel="stylesheet">

<style>
:root {
  --couleur: #ff8fb8;
  --couleur-claire: #ffd3e4;
  --texte: #5a3d5c;
  --fond: #fff0f6;
}

body.pause {
  --couleur: #6fd6aa;
  --couleur-claire: #d4f6e8;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Fredoka', sans-serif;
  background: linear-gradient(160deg, #fff0f6, #f1e8ff);
  color: var(--texte);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25px 5% 50px;
}

.retour {
  align-self: flex-start;
  color: var(--texte);
  text-decoration: none;
  font-size: 14px;
}

.retour:hover {
  text-decoration: underline;
}

h1 {
  font-size: clamp(28px, 7vw, 38px);
  margin: 20px 0;
  text-align: center;
}

main {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.carte {
  width: min(100%, 420px);
  background: white;
  border-radius: 30px;
  box-shadow: 0 10px 30px rgba(255, 143, 184, 0.25);
  padding: 30px 25px;
  margin-bottom: 25px;
  text-align: center;
}

.onglets {
  display: flex;
  justify-content: center;
  gap: 10px;
}

.onglet {
  border: none;
  background: #f1e8ff;
  color: var(--texte);
  font-family: inherit;
  font-size: 15px;
  padding: 8px 18px;
  border-radius: 20px;
  cursor: pointer;
}

.onglet.actif {
  background: var(--couleur);
  color: white;
}

.temps {
  font-size: 72px;
  font-weight: 600;
  margin: 25px 0 10px;
}

.message {
  min-height: 26px;
  margin-bottom: 20px;
}

.boutons {
  display: flex;
  justify-content: center;
  gap: 12px;
}

.btn {
  border: none;
  background: var(--couleur);
  color: white;
  font-family: inherit;
  font-size: 16px;
  padding: 12px 26px;
  border-radius: 30px;
  cursor: pointer;
}

.btn:hover {
  opacity: 0.85;
}

.btn.clair {
  background: #f1e8ff;
  color: var(--texte);
}

h2 {
  font-size: 22px;
  margin-bottom: 15px;
}

.ajout {
  display: flex;
  gap: 8px;
  margin-bottom: 15px;
}

.ajout input {
  flex: 1;
  min-width: 0;
  border: 3px solid #f1e8ff;
  border-radius: 20px;
  padding: 10px 16px;
  font-family: inherit;
  font-size: 15px;
  color: var(--texte);
}

.ajout input:focus {
  outline: none;
  border-color: var(--couleur);
}

.ajout .btn {
  padding: 10px 18px;
}

.liste {
  list-style: none;
  text-align: left;
}

.liste li {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--fond);
  border-radius: 16px;
  padding: 10px 14px;
  margin-bottom: 8px;
}

.liste span {
  flex: 1;
  cursor: pointer;
  word-break: break-word;
}

.liste li.faite span {
  text-decoration: line-through;
  opacity: 0.5;
}

.liste button {
  border: none;
  background: none;
  color: var(--texte);
  font-size: 16px;
  cursor: pointer;
  opacity: 0.5;
}

.liste button:hover {
  opacity: 1;
}
</style>
</head>

<body>

<a href="https://plemicines-art.github.io/inesgluscevic.github.io/" class="retour">← Retour au portfolio</a>

<h1>Minuteur Pomodoro 🧸</h1>

<main>

  <section class="carte">
    <div class="onglets">
      <button class="onglet actif" id="ongletTravail">Travail 25 min</button>
      <button class="onglet" id="ongletPause">Pause 5 min</button>
    </div>

    <div class="temps" id="temps">25:00</div>

    <p class="message" id="message">C'est l'heure de travailler</p>

    <div class="boutons">
      <button class="btn" id="demarrer">Démarrer</button>
      <button class="btn clair" id="recommencer">Recommencer</button>
    </div>
  </section>

  <section class="carte">
    <h2>Mes tâches ☁️</h2>

    <form class="ajout" id="formulaire">
      <input type="text" id="nouvelleTache" placeholder="Écris une tâche..." maxlength="60" aria-label="Nouvelle tâche">
      <button class="btn" type="submit">Ajouter</button>
    </form>

    <ul class="liste" id="liste"></ul>
  </section>

</main>

<script>
const tempsEl = document.getElementById('temps');
const messageEl = document.getElementById('message');
const boutonDemarrer = document.getElementById('demarrer');
const ongletTravail = document.getElementById('ongletTravail');
const ongletPause = document.getElementById('ongletPause');

let mode = 'travail';
let secondes = 25 * 60;
let minuteur = null;

function afficher() {
  const min = String(Math.floor(secondes / 60)).padStart(2, '0');
  const sec = String(secondes % 60).padStart(2, '0');
  tempsEl.textContent = min + ':' + sec;
}

function arreter() {
  clearInterval(minuteur);
  minuteur = null;
  boutonDemarrer.textContent = 'Démarrer';
}

function changerMode(nouveauMode) {
  arreter();
  mode = nouveauMode;
  if (mode === 'travail') {
    secondes = 25 * 60;
    messageEl.textContent = "C'est l'heure de travailler";
  } else {
    secondes = 5 * 60;
    messageEl.textContent = "C'est l'heure de la pause";
  }
  document.body.classList.toggle('pause', mode === 'pause');
  ongletTravail.classList.toggle('actif', mode === 'travail');
  ongletPause.classList.toggle('actif', mode === 'pause');
  afficher();
}

function terminer() {
  if (mode === 'travail') {
    changerMode('pause');
    messageEl.textContent = 'Bravo ! Tu peux faire une pause';
  } else {
    changerMode('travail');
    messageEl.textContent = 'La pause est finie, on repart !';
  }
}

function demarrer() {
  if (minuteur !== null) {
    arreter();
    return;
  }
  boutonDemarrer.textContent = 'Pause';
  minuteur = setInterval(function () {
    secondes = secondes - 1;
    afficher();
    if (secondes === 0) {
      terminer();
    }
  }, 1000);
}

boutonDemarrer.addEventListener('click', demarrer);
ongletTravail.addEventListener('click', function () { changerMode('travail'); });
ongletPause.addEventListener('click', function () { changerMode('pause'); });
document.getElementById('recommencer').addEventListener('click', function () { changerMode(mode); });

const formulaire = document.getElementById('formulaire');
const champ = document.getElementById('nouvelleTache');
const liste = document.getElementById('liste');

formulaire.addEventListener('submit', function (e) {
  e.preventDefault();
  const texte = champ.value.trim();
  if (texte === '') return;

  const li = document.createElement('li');

  const span = document.createElement('span');
  span.textContent = texte;
  span.addEventListener('click', function () {
    li.classList.toggle('faite');
  });

  const supprimer = document.createElement('button');
  supprimer.textContent = '✕';
  supprimer.setAttribute('aria-label', 'Supprimer la tâche');
  supprimer.addEventListener('click', function () {
    li.remove();
  });

  li.appendChild(span);
  li.appendChild(supprimer);
  liste.appendChild(li);
  champ.value = '';
});

afficher();
</script>

</body>
</html>
